POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=1080

CRON_SECRET=dev-cron-secret

# Integração Discord (benefício de apoiador) — valores fake para dev/testes.
# Em produção, configurar com os valores reais no painel da Vercel.
DISCORD_CLIENT_ID=dev-discord-client-id
DISCORD_CLIENT_SECRET=dev-discord-client-secret
DISCORD_BOT_TOKEN=dev-discord-bot-token
DISCORD_GUILD_ID=000000000000000000
DISCORD_SUPPORTER_ROLE_ID=000000000000000000
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/discord/callback

# Integração Mercado Pago (apoio mensal) — credenciais de TESTE, como as do
# Discord acima. As de produção vivem só no painel da Vercel.
MERCADOPAGO_PUBLIC_KEY=APP_USR-ae1053e1-5b1d-4d9c-b098-44939be9cf4a
MERCADOPAGO_ACCESS_TOKEN=APP_USR-5604466577248286-082015-abf1cddae09284a1ed503c2b0c45ccc7-3628806109
MERCADOPAGO_WEBHOOK_SECRET=2a229aebfe32c887826ffb534541379d876d2b3b6148f138859160acdb4f3129
# A API recusa localhost, então em dev o back_url aponta para o túnel do
# cloudflared. A URL do quick tunnel muda a cada `cloudflared tunnel --url
# http://localhost:3000`: quando mudar, troque aqui e no webhook do painel.
# Sem esta variável o valor é derivado — VERCEL_BRANCH_URL em preview,
# VERCEL_URL como reserva, e o domínio público em último caso.
MERCADOPAGO_BACK_URL=https://dome-execute-turn-diploma.trycloudflare.com/apoiar
